# ---- Public-facing host ----
# The domain Caddy issues TLS for. No scheme, no trailing slash.
# Point an A record at your VPS before the first `docker compose up`.
DOMAIN=qualyx.example.com

# ---- Database (Supabase) ----
# Session pooler connection string for the Qualyx Supabase project.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL_DIRECT=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
DATABASE_SSL=true

# ---- NextAuth ----
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# ---- Notifications / integrations (optional) ----
# MAILOSAUR_API_KEY=
# MAILOSAUR_SERVER_ID=
# SLACK_WEBHOOK_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
